# Copie para .env (ou exporte as variáveis no servidor). O Django NÃO lê .env
# sozinho: carregue com seu gerenciador de processos/serviço ou `export`.

# --- obrigatório em produção ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=loja.exemplo.com.br,www.loja.exemplo.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://loja.exemplo.com.br

# --- opcional ---
# DJANGO_BEHIND_PROXY=1        # atrás de nginx/proxy HTTPS
# DJANGO_SSL_REDIRECT=1        # padrão: 1 quando DEBUG=0
# DJANGO_HSTS_SECONDS=31536000 # só ative com HTTPS funcionando
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Botão de WhatsApp: só aparece se houver número real (DDI+DDD+número, só dígitos)
# OSSTORE_WHATSAPP=5521999999999
